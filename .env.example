# GEMINI_API_KEY: Primary Gemini API key (or multiple comma/newline-separated keys).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Extra Gemini API keys (comma or newline separated) for automatic quota rotation.
GEMINI_API_KEYS=""

# Optional numbered Gemini keys (for separate GitHub Repository Secrets):
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEY_4=""
# GEMINI_API_KEY_5=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Subpath for GitHub Pages (e.g. "/Shortvedio2/"). Leave "/" for root deployments.
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Optional deployed backend URL when routing AI requests through a backend server.
# Leave empty to use built-in same-origin /api/* or GitHub Secrets client rotation.
VITE_API_BASE_URL=""
